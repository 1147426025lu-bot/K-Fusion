# PLCFusion 平台：x86_64 PREEMPT_RT（通用 PC / 工控机）
# 用法: export PLC_PLATFORM=x86_64
PLATFORM_ID=x86_64
PLATFORM_ARCH=x86_64
PLATFORM_LABEL="x86_64 PREEMPT_RT (generic PC)"

FUSE_LLC_ARCH=x86-64
FUSE_LLC_ATTR=+sse4.2
# 仅在 x86 主机上设置 FUSE_CLANG_TARGET=x86_64-linux-gnu；Pi 交叉编 LLC 即可

# 四核示例：CPU0 housekeeping，CPU1 探针；按实机核数改 JITTER_PROBE_CPU / isolcpus
JITTER_PROBE_CPU=1
HOUSEKEEPING_CPUS=0
HOUSEKEEPING_CPU_MASK=1
STRESS_LOAD_CPUS=0
RT_NETDEV=enp0s3
RT_TIMER_IRQ_NAME="Local timer"

KERNEL_HEADERS_HINT="sudo apt install linux-headers-\$(uname -r)  # 需 PREEMPT_RT 内核"
CMDLINE_ISOLCPUS_EXAMPLE="isolcpus=1 nohz_full=1 rcu_nocbs=1 intel_pstate=disable nosmt"
