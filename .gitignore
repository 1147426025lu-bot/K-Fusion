# ============================================
# plc_compiler_rpi5 — Git ignore
# ============================================

# --- 构建产物（全树）---
**/build/
**/cache/
*.o
.*.o
*.ko
*.mod
*.mod.c
*.mod.o
*.o_shipped
*.ll
*.so
*.a
*.cmd
.*.cmd
.tmp_versions/
Module.symvers
modules.order
**/hypervisor.lds
**/include/generated/

# --- 编译中间文件 ---
*.kernel.c
*.reloc.txt
*.objdump.txt

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- 本地 IDE（保留 extensions.json）---
.vscode/settings.json

# --- 实验日志 / 基准数据（compare 仅保留 README）---
compare/*
!compare/README.md
!compare/.gitignore

# --- crtos 运行日志 ---
crtos/logs/*
!crtos/logs/.gitignore

# --- 大体积上游 clone（按需脚本拉取）---
crtos/upstream/fixstars/
crtos/cache/
timedc/upstream/ktc/

# --- plcfusion 测试生成物 ---
plcfusion/test/.official_cycletest_wcet_*/
plcfusion/test/.fusion_ast_*
plcfusion/test/*.detected.env
plcfusion/test/*.host_profile.env
plcfusion/test/*.fusion_report
plcfusion/test/*.validate.json
plcfusion/test/*.fusion_ast.json
plcfusion/test/*.fusion_plan.json
plcfusion/test/*.plc_ast.json
plcfusion/test/*.plc_ast.env
plcfusion/test/*.manifest.suggest.env
plcfusion/test/*.apply_ast.json
plcfusion/test/*.entries
plcfusion/test/*.remap_hints
plcfusion/test/rt-tests/
plcfusion/test/tacle-bench/
plcfusion/test/vendor/
plcfusion/test/platform_*/

# --- 大体积 vendor 克隆（按需 init）---
# 若已提交子模块则勿忽略；此处仅忽略未跟踪的临时 clone
