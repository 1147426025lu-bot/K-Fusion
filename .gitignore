# ============================================
# K-Fusion — Git ignore
# ============================================

# --- 构建产物（全树）---
**/build/
**/cache/
*.o
.*.o
*.ko
*.mod
*.mod.c
*.mod.o
*.o_shipped
*.ll
!kfusion/backend/test/*.ll
# 分析器的回归用例：它们是自测的输入，必须入库，
# 否则干净克隆后 `effect_summary_selftest` 直接找不到 fixture（2026-10-23 审查 P1）
!kfusion/analysis/test/*.ll
*.so
*.a
*.cmd
.*.cmd
.tmp_versions/
Module.symvers
modules.order
**/hypervisor.lds
**/include/generated/

# --- 编译中间文件 ---
*.kernel.c
*.reloc.txt
*.objdump.txt

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- 本地 IDE（保留 extensions.json）---
.vscode/settings.json

# --- 实验日志 / 基准数据（compare 仅保留 README）---
compare/*
!compare/README.md
!compare/.gitignore

# --- crtos 运行日志 ---
crtos/logs/*
!crtos/logs/.gitignore

# --- 大体积上游 clone（按需脚本拉取）---
crtos/upstream/fixstars/
crtos/cache/
timedc/upstream/ktc/

# --- kfusion 测试生成物 / vendor ---
kfusion/test/quick_validate/
kfusion/test/rt-tests/
kfusion/test/tacle-bench/
kfusion/test/**/rt-tests/
kfusion/test/vendor/
kfusion/test/platform_*/
kfusion/test/.official_cycletest_wcet_*/
kfusion/test/.fusion_ast_*
kfusion/test/**/*.detected.env
kfusion/test/**/*.host_profile.env
kfusion/test/**/*.fusion_report
kfusion/test/**/*.validate.json
kfusion/test/**/*.fusion_ast.json
kfusion/test/**/*.fusion_plan.json
kfusion/test/**/*.plc_ast.json
kfusion/test/**/*.plc_ast.env
kfusion/test/**/*.manifest.suggest.env
kfusion/test/**/*.apply_ast.json
kfusion/test/**/*.entries
kfusion/test/**/*.remap_hints
kfusion/test/**/*.unmapped
kfusion/test/**/*.wcet_sweep.tsv
kfusion/test/**/*.discover_tu.log
kfusion/test/**/*.preflight.log
kfusion/test/**/*.pipeline.log
kfusion/test/**/*.pipeline_policy.log
kfusion/test/**/*.ir_analysis.log
kfusion/test/**/*_runtime_stubs.c
!kfusion/test/plc_runtime_stubs.c
kfusion/test/**/*.stubs.generated.c
kfusion/test/**/*.wcet_schedule.json
kfusion/test/**/*.wcet_per_function.json
kfusion/test/**/*.wcet_per_function.env
kfusion/test/**/*.wcet_suggest.env
kfusion/test/ci_wcet_probe.json
kfusion/test/.ci_wcet_probe.out
kfusion/test/**/*.wcet_ci_smoke.err
kfusion/test/.wcet_per_fn_search/
kfusion/test/.github_rt_periodic_wcet_per_fn/
kfusion/test/.official_cycletest_multitu_wcet_per_fn/

# --- xlat 跨域/负载档原始样本数据 ---
# 单文件最大 418 MB（xlat_8h.bin），超过 GitHub 100 MB 硬限；且可由脚本重跑。
# 入库的是：PNG 图 + root_1h.hist 直方图文本 + 说明文档；原始 .bin 留在 Pi 上。
# 复现见 crtos/results/xlat/README__数据与复现说明.md
crtos/results/xlat/*.bin
crtos/results/xlat/**/*.bin

# --- 本地工作目录（不进库）---
.workbuddy/

# --- 零散构建残渣 ---
**/_k.tgz

# 临时审查快照（从 Pi 拉回对比用，不入库）
.review/

# PR-10A 端到端产物目录（构建输出，不入库）
kfusion/docs/pr9b_pid_codegen/gen/

# PR-10B 构建产物
kfusion/docs/pr10b_matrix/cells/*/gen/
kfusion/docs/pr10b_matrix/v2/*/gen/
