# plc_multitask — 论文 W5 测量（STRICT LET + MtSummary/LetSummary）
# 用法: bash scripts/paper/run_paper_multitask__论文多任务.sh

FUSE_NAME=plc_multitask
FUSE_DESC="Multi-task STRICT LET scheduler (paper measurement, duration-driven)"

FUSE_SRC_ROOT=.
FUSE_SOURCE=examples/plc_multitask__多任务示例/plc_multitask_demo__主程序.c
FUSE_EXTRA_SOURCES='examples/plc_multitask__多任务示例/plc_multitask_scheduler__调度器.c examples/plc_multitask__多任务示例/plc_multitask_tasks__任务集.c src/runtime/plc_let__LET.c'
FUSE_INCLUDE_DIRS='examples/plc_multitask__多任务示例 include'
FUSE_CLANG_FLAGS='-O2 -fno-builtin -D_GNU_SOURCE -ffp-contract=off -DMT_RUN_LOOPS=0 -DPLC_FUSED_BUILD=1'

FUSE_RUN_MAIN=1
FUSE_HOST=hrtimer
FUSE_LINK_RUNTIME_STUBS=1
FUSE_LINK_PTHREAD_HOST=0
FUSE_FIXED_POINT=1

FUSE_GLOBALIZE_SYMBOLS=
FUSE_PIPELINE_POLICY=ast-auto
FUSE_PIPELINE=debug
FUSE_WCET_MODE=0
FUSE_HOT_PATH_FUNCTIONS='main,plc_let_run,plc_let_tick,mt_supervisor_job,task_sensor_fusion,task_pid_control,task_watchdog_poll'
FUSE_DCE_ROOTS='main,plc_let_init,plc_let_run,plc_let_tick,mt_let_setup,mt_let_run,mt_supervisor_job,mt_state_init,task_sensor_fusion,task_pid_control,task_alarm_log,task_stats_heap,task_watchdog_poll'
FUSE_LOW_JITTER=0
FUSE_MAX_UNMAPPED=0

FUSE_LLC_ARCH=aarch64
FUSE_LLC_ATTR=-fp-armv8,-neon

FUSE_AST_PREFLIGHT=1
FUSE_AUTO_DETECT=1
FUSE_AUTO_STUBS=1
FUSE_PREFLIGHT=1

FUSE_DETECT_GLOBALS='__daylight,__environ,__timezone,__tzname,daylight,environ,g_alarm_active,g_alarm_edges,g_fused_temp,g_mt_let,g_mt_period,g_mt_task_runs,g_mt_tick,g_pid_output,g_state_lock,getdate_err,optarg,opterr,optind,optopt,shutdown,stderr,stdin,stdout,timezone,tzname'
