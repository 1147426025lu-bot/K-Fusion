# PLCFusion 清单：Linux Foundation rt-tests 官方 cyclictest（默认主线）
# 用法: bash scripts/plc_fuse__内核化主流程.sh manifests/manifest_cyclictest__主线压测.env

FUSE_NAME=official_cycletest
FUSE_DESC="rt-tests cyclictest (LF PREEMPT_RT wiki)"

# 从 kernel.org 拉取；已存在 test/rt-tests 则跳过 clone
FUSE_GIT_URL=https://git.kernel.org/pub/scm/utils/rt-tests/rt-tests.git
FUSE_GIT_DIR=rt-tests
FUSE_GIT_DEPTH=1

# 相对 FUSE_GIT_DIR 的源文件（与 wiki 文档中的 cyclictest 同源）
FUSE_SOURCE=src/cyclictest/cyclictest.c
FUSE_INCLUDE_DIRS=src/include

# Clang 前端参数（不改 .c 源码）
FUSE_CLANG_FLAGS='-O2 -fno-builtin -D_GNU_SOURCE -DVERSION="2.8"'

# objcopy 提升为全局符号，供宿主模块读写（cyclictest 协作退出）
FUSE_GLOBALIZE_SYMBOLS='shutdown use_nsecs'

# 通用宿主：main + hrtimer + pthread（与 signaltest/ptsematest 同路径，不用 plc_runner_official）
FUSE_RUN_MAIN=1
FUSE_HOST=hrtimer
FUSE_LINK_RUNTIME_STUBS=1
FUSE_LINK_PTHREAD_HOST=1
# rt-tests cyclictest 默认参数（可通过 insmod 参数 main_args= 覆盖）
FUSE_MAIN_ARGS='-p 99 -i 1000 -m -q -h 100000'

# Pass 组合: auto → wcet（FUSE_WCET_MODE=1）；策略 wcet-benchmark 允许后续 WCET 搜索
FUSE_PIPELINE_POLICY=wcet-benchmark
FUSE_WCET_MODE=1
FUSE_HOT_PATH_FUNCTIONS=timerthread,fifothread
FUSE_LOW_JITTER=1
FUSE_PIPELINE=auto

# 浮点 → Q 定点（替代 float_kill / compiler_rt）
FUSE_FIXED_POINT=1
# 若 test/official_cycletest.autotune.env 存在则自动加载 Pass 优胜组合
FUSE_WCET_USE_AUTOTUNE=1

# LLC 后端（按目标平台修改）
FUSE_LLC_ARCH=aarch64
FUSE_LLC_ATTR=-fp-armv8,-neon
