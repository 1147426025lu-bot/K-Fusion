# ============================================================================
# ptsematest.env — rt-tests pthread mutex 延迟测量融合清单
# 用法:
#   bash scripts/plc_kernelize__内核化.sh manifests/manifest_ptsematest__互斥锁测试.env
#   bash scripts/plc_fuse_report__覆盖率报告.sh manifests/manifest_ptsematest__互斥锁测试.env
# ============================================================================
FUSE_NAME=ptsematest
FUSE_DESC="rt-tests ptsematest (pthread mutex latency)"

FUSE_GIT_DIR=rt-tests
FUSE_SOURCE=src/ptsematest/ptsematest.c
FUSE_INCLUDE_DIRS=src/include

FUSE_CLANG_FLAGS='-O2 -fno-builtin -D_GNU_SOURCE -DVERSION="2.8"'

FUSE_GLOBALIZE_SYMBOLS='shutdown'

FUSE_RUN_MAIN=1
FUSE_HOST=hrtimer
FUSE_LINK_RUNTIME_STUBS=1
FUSE_LINK_PTHREAD_HOST=1
FUSE_PIPELINE_POLICY=wcet-benchmark
FUSE_WCET_MODE=1
FUSE_HOT_PATH_FUNCTIONS=semathread
FUSE_LOW_JITTER=1
FUSE_STRICT=1
FUSE_STRICT_VALIDATE=1
FUSE_MAX_UNMAPPED=0

FUSE_LLC_ARCH=aarch64
FUSE_LLC_ATTR=-fp-armv8,-neon
