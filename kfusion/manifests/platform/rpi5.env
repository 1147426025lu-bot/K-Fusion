# PLCFusion 平台：Raspberry Pi 5（AArch64 + PREEMPT_RT）
# 用法: export PLC_PLATFORM=rpi5  （aarch64 主机默认）
PLATFORM_ID=rpi5
PLATFORM_ARCH=aarch64
PLATFORM_LABEL="Raspberry Pi 5 (BCM2712, PREEMPT_RT)"

FUSE_LLC_ARCH=aarch64
FUSE_LLC_ATTR=-fp-armv8,-neon

JITTER_PROBE_CPU=3
HOUSEKEEPING_CPUS=0-2
HOUSEKEEPING_CPU_MASK=7
STRESS_LOAD_CPUS=0-2
RT_NETDEV=eth0
RT_TIMER_IRQ_NAME=arch_timer

# WCET 板级探针 golden: test/golden/wcet_probe_rpi5.json
WCET_PROBE_MAX_NS=5000000

KERNEL_HEADERS_HINT="sudo apt install raspberrypi-kernel-headers  # 或 linux-headers-\$(uname -r)"
CMDLINE_ISOLCPUS_EXAMPLE="isolcpus=domain,managed_irq,3 nohz_full=3 rcu_nocbs=3 workqueue.cpumask=7"
