# ============================================================================
# manifest_plc_cc_gpio — plc-cc 示例经 PLCFusion 二次融合
# 用法: bash scripts/plc_fuse__内核化主流程.sh manifests/manifest_plc_cc_gpio__PLC示例.env
# ============================================================================
FUSE_NAME=plc_cc_gpio
FUSE_DESC="plc-cc gpio_blink → fused module"

FUSE_SRC_ROOT=.
FUSE_SOURCE=examples/plc-cc__低抖动示例/gpio_blink__GPIO闪烁.c
FUSE_INCLUDE_DIRS=examples/plc-cc__低抖动示例
FUSE_CLANG_FLAGS='-O2 -fno-builtin -D_GNU_SOURCE -include plc_cc_fuse_shim__融合头.h'

FUSE_KTHREAD_ENTRY=plc_cycle
FUSE_HOT_PATH_FUNCTIONS=plc_cycle
FUSE_DCE_ROOTS=plc_cycle
FUSE_PIPELINE_POLICY=ast-auto
FUSE_WCET_MODE=1
FUSE_LOW_JITTER=1
FUSE_LINK_RUNTIME_STUBS=1
FUSE_HOST=hrtimer
FUSE_LINK_PTHREAD_HOST=0
FUSE_MAX_UNMAPPED=0
FUSE_DCE_SINGLE=1

FUSE_LLC_ARCH=aarch64
FUSE_LLC_ATTR=-fp-armv8,-neon

# plc_ast auto-applied suggestions
FUSE_AST_PREFLIGHT=1
FUSE_AUTO_DETECT=1
FUSE_AUTO_STUBS=1
FUSE_PLC_CC_AST=1
FUSE_PREFLIGHT=1
