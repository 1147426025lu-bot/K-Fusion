# plc-cc hello_plc — 入口 plc_main
FUSE_NAME=plc_cc_hello
FUSE_DESC="plc-cc hello_plc plc_main"

FUSE_SRC_ROOT=.
FUSE_SOURCE=examples/plc-cc__低抖动示例/hello_plc__入门示例.c
FUSE_INCLUDE_DIRS=examples/plc-cc__低抖动示例
FUSE_CLANG_FLAGS='-O2 -fno-builtin -D_GNU_SOURCE -include plc_cc_fuse_shim__融合头.h'

FUSE_KTHREAD_ENTRY=plc_main
FUSE_HOT_PATH_FUNCTIONS=plc_main
FUSE_DCE_ROOTS=plc_main
FUSE_PIPELINE_POLICY=ast-auto
FUSE_WCET_MODE=1
FUSE_LINK_RUNTIME_STUBS=1
FUSE_LINK_PTHREAD_HOST=0
FUSE_HOST=hrtimer
FUSE_MAX_UNMAPPED=0

FUSE_LLC_ARCH=aarch64
FUSE_LLC_ATTR=-fp-armv8,-neon

# plc_ast auto-applied suggestions
FUSE_AST_PREFLIGHT=1
FUSE_AUTO_DETECT=1
FUSE_AUTO_STUBS=1
FUSE_PLC_CC_AST=1
FUSE_PREFLIGHT=1
