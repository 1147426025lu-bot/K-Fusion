# 角色: SWAPPABLE — 复制此文件创建新应用 manifest
# PLCFusion 清单模板 — 复制为 manifests/my_app.env 并修改
#
# 用法:
#   cp manifests/manifest_template__清单模板.env manifests/my_app.env
#   bash scripts/plc_kernelize__内核化.sh manifests/my_app.env

# FUSE_PLC_CC_AST=1              # plc-cc 清单：融合前跑 plc_ast（默认 1）
# FUSE_PLC_CC_AST_STRICT=0         # 1=周期内 malloc/浮点也 fail
FUSE_NAME=my_app
FUSE_DESC="My application kernelized by PLCFusion"

FUSE_SOURCE=path/to/source.c
# 多 TU：空格分隔，相对 FUSE_GIT_DIR（或本地源码根），llvm-link 合并
# FUSE_EXTRA_SOURCES='src/lib/helper.c src/lib/other.c'
FUSE_INCLUDE_DIRS=

FUSE_CLANG_FLAGS='-O2 -fno-builtin -D_GNU_SOURCE'

FUSE_GLOBALIZE_SYMBOLS='shutdown'

# 入口（二选一；可省略，由 FUSE_AUTO_DETECT 从 IR 推断）:
# FUSE_KTHREAD_ENTRY=worker_thread
# FUSE_RUN_MAIN=1

# 自动化（v2.7 默认开启）
# FUSE_AUTO_DETECT=1    # pre.ll → .detected.env
# FUSE_AUTO_STUBS=1     # 缺失符号 → per-app stubs
# FUSE_STUB_LOOP=1      # 桩合并后多轮闭环直至缺桩稳定
# FUSE_PREFLIGHT=1              # 融合前 grep 预检 + AST 融合门禁
# FUSE_AST_PREFLIGHT=1          # AST 融合可行性（fork/dlopen/间接调用等）
# FUSE_AST_PREFLIGHT_STRICT=1   # AST critical 时 exit 1
# FUSE_AST_PLAN=1               # pipeline 读 fusion_plan.json 选 Pass 方案（默认开）
# FUSE_ALLOW_CXX=1              # 允许 .cpp extern-C 子集（AST 拦 class/template/异常）
#
# Pass 策略（FUSE_PIPELINE_POLICY=auto 时按 FUSE_NAME 推断）:
#   ast-auto        — plc-cc / github demo：AST + pipeline 一次定案，不自动 WCET 搜索
#   wcet-benchmark  — cyclictest / signaltest / ptsematest：首次融合同上，可选手动/CI 跑 autotune
#   fixed           — 仅 manifest 中 FUSE_PIPELINE；关闭 AST profile 建议
# 显式示例:
#   FUSE_PIPELINE_POLICY=wcet-benchmark
#   FUSE_AST_APPLY_SUGGEST=1  ast-auto 默认：fuse 前 fill-empty 写 manifest
#   FUSE_WCET_TAIL_PROBE=1     wcet-benchmark：pre.ll 后静态 3 组 tail 快选
# FUSE_PIPELINE=auto    # auto|mainline|hotpath|generic|minimal|debug|size|custom
# FUSE_WCET_MODE=1      # auto 时 kthread 应用优先 hotpath（无 tail、轻 pre）
# FUSE_HOT_PATH_FUNCTIONS=timerthread,fifothread
# FUSE_AUTO_DEBUG=1     # 融合后 refine 用 FUSE_DEBUG_THRESHOLD
# FUSE_DEBUG_PRE_THRESHOLD=0  # >0 时 pre.ll unknown 达阈才预选 debug
# FUSE_AUTO_SIZE=1      # IR/.o 偏大且 unknown 低 → size
# FUSE_DEBUG_THRESHOLD=3
# FUSE_SIZE_IR_LINES=80000
# FUSE_SIZE_OBJ_BYTES=262144

# custom 模式手动组合 Pass:
# FUSE_PIPELINE=custom
# FUSE_KERNEL_PASS='plc-fusion-normalize,plc-fusion-remap,plc-fusion-dce,plc-fusion-cleanup'
# FUSE_TAIL_PASSES='globaldce,globalopt'

FUSE_LINK_RUNTIME_STUBS=1
FUSE_LINK_PTHREAD_HOST=1
FUSE_FIXED_POINT=1
# FUSE_KO_FIXUP_LOOP=1        # Kbuild modpost 失败时自动桩修复（最多 FUSE_KO_FIXUP_MAX 轮）
# FUSE_KO_FIXUP_MAX=3

# 宿主（可省略 — plc_kernelize 会从 pre.ll 自动推断 hrtimer/pthread）
# FUSE_HOST=generic | hrtimer
# FUSE_MAIN_ARGS='-p 99 -n -i 1000'   # FUSE_RUN_MAIN=1 时传给 main()

# 大类速查（均走 plc_kernelize__内核化.sh，无需专用宿主）:
#   rt-tests main 路径     → FUSE_RUN_MAIN=1 + FUSE_LINK_PTHREAD_HOST=1
#   rt-tests + timer       → + FUSE_HOST=hrtimer
#   plc-cc / plc_main      → FUSE_KTHREAD_ENTRY=plc_main + FUSE_HOST=hrtimer
#   单 TU 库 demo (stb)    → FUSE_RUN_MAIN=1
#   多 TU                  → FUSE_EXTRA_SOURCES='...'

# LLC 默认由 PLC_PLATFORM 覆盖（manifests/platform/{rpi5,x86_64}.env）；此处为无平台时的回退
FUSE_LLC_ARCH=aarch64
FUSE_LLC_ATTR=-fp-armv8,-neon
