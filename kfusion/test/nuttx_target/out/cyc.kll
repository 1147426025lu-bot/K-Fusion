%union.sigval = type { ptr }
%union.anon = type { i32 }
%struct.timer_notify_s = type { %struct.sigevent, i32, i8 }
%struct.timer_status_s = type { i32, i32, i32 }
%struct.timespec = type { i64, i64 }
%struct.sched_param = type { i32 }

