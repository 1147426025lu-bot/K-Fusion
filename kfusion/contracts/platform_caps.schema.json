{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/1147426025lu-bot/K-Fusion/contracts/platform_caps.schema.json",
  "title": "K-Fusion 平台能力描述 v1",
  "description": "目标运行域的能力边界。契约校验器用它判定「某个阶段的执行上下文/效果是否被该域允许」。能力必须显式列出，缺失按「不允许」处理（fail-closed）。",
  "type": "object",
  "required": ["version", "platforms"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "contexts", "allow_mmio"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "contexts": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["thread", "softirq", "hardirq", "timer_cb"] }
          },
          "allow_mmio": { "type": "boolean" },
          "allow_sleep": { "type": "boolean" },
          "max_rt_priority": { "type": "integer", "minimum": 1 },
          "supports_float": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
