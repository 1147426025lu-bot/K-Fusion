{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/1147426025lu-bot/K-Fusion/contracts/task_contract.schema.json",
  "title": "K-Fusion 任务契约 v1",
  "description": "ECoS 的输入契约：声明一个周期任务的时间要求、阶段划分与执行效果。校验器据此做 fail-closed 判定（无法证明合法就拒绝）。",
  "type": "object",
  "required": ["version", "task", "stages"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "task": {
      "type": "object",
      "required": ["name", "entry", "period_us", "deadline_us"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 },
        "period_us": { "type": "integer", "minimum": 1 },
        "deadline_us": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "fn", "context", "effects"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "fn": { "type": "string", "minLength": 1 },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "context": {
            "enum": ["thread", "softirq", "hardirq", "timer_cb"],
            "description": "该阶段被允许在哪种执行上下文里跑"
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["pure", "state_read", "state_write", "mmio", "sleep", "blocking_io", "external"]
            },
            "description": "效果摘要；出现白名单以外的值一律视为 UNKNOWN 并拒绝"
          },
          "notes": { "type": "string" }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["mmio", "shm", "log", "none"] },
          "release_id": { "type": "boolean" }
        }
      }
    }
  }
}
