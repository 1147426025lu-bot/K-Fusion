digraph task_dag {
  rankdir=LR;
  graph [fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#4338ca", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  "fir_filter" [label="fir_filter\nstate_read,state_write\nctx: thread,softirq"];
  "pid_step" [label="pid_step\nstate_read,state_write\nctx: thread,softirq"];
  "sensor_prepare" [label="sensor_prepare\nmmio,state_write\nctx: thread,softirq"];
  "fir_filter" -> "pid_step" [color="#1d4ed8", style=solid, label="data RAW", tooltip="@g_fir_out"];
  "sensor_prepare" -> "fir_filter" [color="#1d4ed8", style=solid, label="data RAW", tooltip="@g_sensor_raw"];
}
