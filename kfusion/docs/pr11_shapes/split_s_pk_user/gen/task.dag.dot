digraph task_dag {
  rankdir=LR;
  graph [fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#4338ca", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  "stage_pid" [label="stage_pid\nstate_read,state_write\nctx: thread,softirq\nt=200µs"];
  "stage_sample" [label="stage_sample\nstate_read,state_write\nctx: thread,softirq\nt=0µs"];
  "stage_sink" [label="stage_sink\npure\nctx: thread,softirq\nt=400µs"];
  "stage_sample" -> "stage_pid" [color="#1d4ed8", style=solid, label="data RAW", tooltip="@g_in"];
}
