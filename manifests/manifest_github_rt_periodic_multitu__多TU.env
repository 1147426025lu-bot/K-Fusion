# ============================================================================
# github_rt_periodic multitu — 本地周期 demo + stats 辅助 TU
# ============================================================================
FUSE_NAME=github_rt_periodic_multitu
FUSE_DESC="rt_periodic + rt_periodic_stats (multi-TU llvm-link)"

FUSE_SOURCE=github_demo__本地demo/rt_periodic__周期demo.c
FUSE_EXTRA_SOURCES=github_demo__本地demo/rt_periodic_stats__stats.c
FUSE_INCLUDE_DIRS=
FUSE_CLANG_FLAGS='-O2 -fno-builtin -D_GNU_SOURCE'

FUSE_RUN_MAIN=1
FUSE_LINK_RUNTIME_STUBS=1
FUSE_HOST=hrtimer
FUSE_LINK_PTHREAD_HOST=0
FUSE_GLOBALIZE_SYMBOLS='shutdown'
FUSE_PIPELINE_POLICY=ast-auto
FUSE_WCET_MODE=1
FUSE_HOT_PATH_FUNCTIONS=main
FUSE_DCE_ROOTS=main,on_signal

FUSE_LLC_ARCH=aarch64
FUSE_LLC_ATTR=-fp-armv8,-neon

# plc_ast auto-applied suggestions
FUSE_AST_PREFLIGHT=1
FUSE_AUTO_DETECT=1
FUSE_AUTO_STUBS=1
FUSE_DETECT_GLOBALS='__daylight,__environ,__timezone,__tzname,daylight,environ,getdate_err,optarg,opterr,optind,optopt,shutdown,stderr,stdin,stdout,timezone,tzname'
FUSE_PREFLIGHT=1
