# PLCFusion: rt-tests signaltest（示例 — 跑 main 路径）
# 用法:
#   bash scripts/plc_fuse__内核化主流程.sh manifests/manifest_signaltest__信号测试.env
#   bash scripts/plc_fuse_report__覆盖率报告.sh manifests/manifest_signaltest__信号测试.env
#   bash scripts/ignite_fused__通用ko构建.sh manifests/manifest_signaltest__信号测试.env

FUSE_NAME=signaltest
FUSE_DESC="rt-tests signaltest (signal roundtrip)"

FUSE_GIT_URL=git://git.kernel.org/pub/scm/utils/rt-tests/rt-tests.git
FUSE_GIT_DIR=rt-tests
FUSE_GIT_DEPTH=1

FUSE_SOURCE=src/signaltest/signaltest.c
FUSE_INCLUDE_DIRS=src/include

FUSE_CLANG_FLAGS='-O2 -fno-builtin -D_GNU_SOURCE -DVERSION="2.8"'

FUSE_GLOBALIZE_SYMBOLS='shutdown tracelimit'

FUSE_RUN_MAIN=1
FUSE_LINK_RUNTIME_STUBS=1
FUSE_LINK_PTHREAD_HOST=1
FUSE_PIPELINE_POLICY=wcet-benchmark
FUSE_WCET_MODE=1
FUSE_HOT_PATH_FUNCTIONS=signalthread
FUSE_LOW_JITTER=1
FUSE_MAX_UNMAPPED=0

FUSE_LLC_ARCH=aarch64
FUSE_LLC_ATTR=-fp-armv8,-neon
