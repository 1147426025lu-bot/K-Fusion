# TACLeBench minver — Mälardalen 3x3 浮点矩阵求逆 WCET 测试
# 来源: https://github.com/tacle/tacle-bench bench/kernel/minver/minver.c
# 用法:
#   bash scripts/plc_fuse__内核化主流程.sh manifests/manifest_tacle_minver__矩阵求逆.env
#   bash scripts/ignite_fused__通用ko构建.sh manifests/manifest_tacle_minver__矩阵求逆.env

FUSE_NAME=tacle_minver
FUSE_DESC="TACLeBench minver (MRTC matrix inversion, FP)"

FUSE_GIT_URL=https://github.com/tacle/tacle-bench.git
FUSE_GIT_DIR=tacle-bench
FUSE_GIT_DEPTH=1

FUSE_SOURCE=bench/kernel/minver/minver.c

FUSE_CLANG_FLAGS='-O2 -fno-builtin -D_GNU_SOURCE'

FUSE_KTHREAD_ENTRY=minver_main
FUSE_RUN_MAIN=0
FUSE_HOT_PATH_FUNCTIONS=minver_main,minver_minver,minver_mmul
FUSE_DCE_ROOTS=minver_main
FUSE_PIPELINE_POLICY=wcet-benchmark
FUSE_WCET_MODE=1
FUSE_LOW_JITTER=1
FUSE_LINK_RUNTIME_STUBS=1
FUSE_LINK_PTHREAD_HOST=0
FUSE_HOST=generic
FUSE_FIXED_POINT=1
FUSE_MAX_UNMAPPED=0

FUSE_AUTO_DETECT=1
FUSE_AUTO_STUBS=1
FUSE_PREFLIGHT=1
FUSE_AST_PREFLIGHT=1
FUSE_AST_PLAN=1

FUSE_LLC_ARCH=aarch64
FUSE_LLC_ATTR=-fp-armv8,-neon
