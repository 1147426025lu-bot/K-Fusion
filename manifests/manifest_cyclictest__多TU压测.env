# PLCFusion 清单：cyclictest + histogram（多翻译单元 llvm-link 演示）
# 用法: bash scripts/plc_fuse__内核化主流程.sh manifests/manifest_cyclictest__多TU压测.env

FUSE_NAME=official_cycletest_multitu
FUSE_DESC="rt-tests cyclictest + histogram.c (multi-TU llvm-link)"

FUSE_GIT_URL=git://git.kernel.org/pub/scm/utils/rt-tests/rt-tests.git
FUSE_GIT_DIR=rt-tests
FUSE_GIT_DEPTH=1

FUSE_SOURCE=src/cyclictest/cyclictest.c
FUSE_EXTRA_SOURCES=src/lib/histogram.c
FUSE_INCLUDE_DIRS=src/include

FUSE_CLANG_FLAGS='-O2 -fno-builtin -D_GNU_SOURCE -DVERSION="2.8"'

FUSE_GLOBALIZE_SYMBOLS='shutdown use_nsecs'
FUSE_RUN_MAIN=1
FUSE_HOST=hrtimer
FUSE_LINK_RUNTIME_STUBS=1
FUSE_LINK_PTHREAD_HOST=1
FUSE_MAIN_ARGS='-p 99 -n -i 1000 -m -q'

FUSE_PIPELINE_POLICY=wcet-benchmark
FUSE_WCET_MODE=1
FUSE_HOT_PATH_FUNCTIONS=timerthread,fifothread
FUSE_LOW_JITTER=1
FUSE_FIXED_POINT=1
FUSE_AUTO_DISCOVER_TU=1

FUSE_LLC_ARCH=aarch64
FUSE_LLC_ATTR=-fp-armv8,-neon
