# GitHub 拉取试跑：nothings/stb tests/test_sprintf.c + stb_sprintf.h
# 拉取命令（已执行）:
#   curl -o test/github_demo__本地demo/github_tick__tick示例.c \
#     https://raw.githubusercontent.com/nothings/stb/master/tests/test_sprintf.c
#   curl -o test/github_demo__本地demo/stb_sprintf__第三方sprintf.h \
#     https://raw.githubusercontent.com/nothings/stb/master/stb_sprintf.h

FUSE_NAME=github_stb_sprintf
FUSE_DESC="nothings/stb test_sprintf.c from GitHub"

FUSE_SOURCE=github_demo__本地demo/github_tick__tick示例.c
FUSE_INCLUDE_DIRS=github_demo__本地demo
FUSE_CLANG_FLAGS='-O2 -fno-builtin -D_GNU_SOURCE -DUSE_STB=1 -DTEST_SPRINTF=1 -DSTB_SPRINTF_IMPLEMENTATION'

FUSE_RUN_MAIN=1
FUSE_LINK_RUNTIME_STUBS=1
# stb 内部 API 形参为 double，不适用 Q 定点（本 manifest 专测 sprintf 浮点格式）
FUSE_FIXED_POINT=0
FUSE_WCET_MODE=1
FUSE_PIPELINE=hotpath
FUSE_AUTO_REFINE=0
FUSE_HOT_PATH_FUNCTIONS=main
FUSE_DCE_ROOTS=main
FUSE_MAX_UNMAPPED=0

FUSE_LLC_ARCH=aarch64
FUSE_LLC_ATTR=-fp-armv8,-neon
