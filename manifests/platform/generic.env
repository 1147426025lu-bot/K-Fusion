# 未知平台回退：按 uname -m 选 LLC，隔离参数需用户自设
PLATFORM_ID=generic
PLATFORM_ARCH="$(uname -m)"
PLATFORM_LABEL="generic ($(uname -m))"

case "$(uname -m)" in
    x86_64|amd64)
        FUSE_LLC_ARCH=x86-64
        FUSE_LLC_ATTR=+sse4.2
        JITTER_PROBE_CPU=1
        HOUSEKEEPING_CPUS=0
        HOUSEKEEPING_CPU_MASK=1
        ;;
    aarch64|arm64)
        FUSE_LLC_ARCH=aarch64
        FUSE_LLC_ATTR=-fp-armv8,-neon
        JITTER_PROBE_CPU=3
        HOUSEKEEPING_CPUS=0-2
        HOUSEKEEPING_CPU_MASK=7
        ;;
    *)
        FUSE_LLC_ARCH=aarch64
        FUSE_LLC_ATTR=
        JITTER_PROBE_CPU=0
        HOUSEKEEPING_CPUS=0
        HOUSEKEEPING_CPU_MASK=1
        ;;
esac

STRESS_LOAD_CPUS="${HOUSEKEEPING_CPUS:-0}"
RT_NETDEV=eth0
RT_TIMER_IRQ_NAME=arch_timer
KERNEL_HEADERS_HINT="安装与运行内核匹配的 linux-headers"
CMDLINE_ISOLCPUS_EXAMPLE="isolcpus=<probe_cpu> nohz_full=<probe_cpu>"
