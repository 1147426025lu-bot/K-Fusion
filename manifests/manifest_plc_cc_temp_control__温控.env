# plc-cc temp_control — double 由 Q 定点 Pass 转换（Q32.32）
FUSE_NAME=plc_cc_temp_control
FUSE_DESC="plc-cc temp_control with Q fixed-point semantics"

FUSE_SRC_ROOT=.
FUSE_SOURCE=examples/plc-cc__低抖动示例/temp_control__温控.c
FUSE_INCLUDE_DIRS='examples/plc-cc__低抖动示例 include'
FUSE_CLANG_FLAGS='-O2 -fno-builtin -D_GNU_SOURCE -include plc_cc_fuse_shim__融合头.h'
FUSE_FIXED_POINT=1

FUSE_KTHREAD_ENTRY=plc_cycle
FUSE_HOT_PATH_FUNCTIONS=plc_cycle
FUSE_DCE_ROOTS=plc_cycle
FUSE_PIPELINE_POLICY=ast-auto
FUSE_WCET_MODE=1
FUSE_LINK_RUNTIME_STUBS=1
FUSE_HOST=hrtimer
FUSE_MAX_UNMAPPED=0

FUSE_LLC_ARCH=aarch64
FUSE_LLC_ATTR=-fp-armv8,-neon

# plc_ast auto-applied suggestions
FUSE_AST_PREFLIGHT=1
FUSE_AUTO_DETECT=1
FUSE_AUTO_STUBS=1
FUSE_DETECT_GLOBALS='g_heater_status,g_plc_counter,g_sensor_data'
FUSE_PLC_CC_AST=1
FUSE_PREFLIGHT=1
